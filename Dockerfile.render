FROM nginx:alpine

# 写入 Render 专属的反向代理配置
RUN cat <<'EOF' > /etc/nginx/conf.d/default.conf
server {
    listen 80;
    server_name localhost;

    gzip on;
    gzip_types text/plain application/json application/javascript text/css application/xml;

    location = / {
        default_type text/html;
        return 200 '<!DOCTYPE html><html><body style="font-family:sans-serif;background:#0f172a;color:#fff;text-align:center;padding:50px;"><h1 style="color:#10b981;">⚡ Render Google API Proxy is Active!</h1><p style="color:#94a3b8;">Deployed on US Oregon Data Center - 100% Supported by Google</p></body></html>';
    }

    # 路由 1: 谷歌反重力 / Cloud Code 请求 (/v1internal)
    location ~* ^/v1internal {
        proxy_pass https://cloudcode-pa.googleapis.com;
        proxy_set_header Host cloudcode-pa.googleapis.com;

        # 清洗可能导致地域泄漏的 Header
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;

        # 支持长连接与流式输出 (SSE stream)
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        proxy_connect_timeout 300s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_ssl_name cloudcode-pa.googleapis.com;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    }

    # 路由 2: 常规 Google Gemini API 请求 (/v1beta, /v1)
    location / {
        proxy_pass https://generativelanguage.googleapis.com;
        proxy_set_header Host generativelanguage.googleapis.com;

        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;

        proxy_connect_timeout 300s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        proxy_ssl_name generativelanguage.googleapis.com;
        proxy_ssl_server_name on;
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
