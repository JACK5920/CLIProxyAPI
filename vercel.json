{
  "version": 2,
  "routes": [
    {
      "src": "/proxy/(.*)",
      "dest": "/api/proxy"
    },
    {
      "src": "/v1internal/(.*)",
      "dest": "/api/proxy"
    },
    {
      "src": "/v1beta/(.*)",
      "dest": "/api/proxy"
    },
    {
      "src": "/v1/(.*)",
      "dest": "/api/proxy"
    }
  ]
}
